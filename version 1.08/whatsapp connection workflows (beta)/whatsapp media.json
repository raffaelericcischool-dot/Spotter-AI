    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-1",
              "name": "message",
              "value": "={{ (() => {\n  const m = $('Start').item.json.messages[0];\n  const t = m.type;\n  const media = m[t] || {};\n  const caption = media.caption ? '\\nMessaggio allegato: ' + media.caption : '';\n  if (t === 'text') return m.text.body;\n  if (t === 'audio') return \"[L'atleta ha inviato un messaggio vocale. Trascrizione]\\n\" + ($json.text || '');\n  if (t === 'image') {\n    return \"[L'atleta ha inviato un'immagine. Descrizione]\\n\" + ($json.text || '') + caption;\n  }\n  if (t === 'document') {\n    const content = String($json.text || '').slice(0, 20000);\n    if (content) return \"[L'atleta ha inviato il file \" + (media.filename || '') + '. Contenuto]\\n' + content + caption;\n    return \"[L'atleta ha inviato il file \" + (media.filename || '') + \" (\" + (media.mime_type || '') + \"), ma il formato non si puo leggere. Chiedigli di inviarlo come PDF, testo o foto.]\" + caption;\n  }\n  return \"[L'atleta ha inviato un contenuto di tipo \" + t + \" che non si puo leggere. Chiedigli di scriverlo o inviarlo come testo, vocale, foto o PDF.]\";\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
